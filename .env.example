# Copy to .env if you need to change defaults. Nothing here is required for the browser demo.
# Model server (npm run model-server)
PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
PREDICT_TIMEOUT_MS=120000
# Static build base path for GitHub Pages (default: relative './')
# VITE_BASE=/egoversa/
# Export of a trained student to GGUF (research/scripts/quantize_model.py)
# LLAMA_CPP_DIR=~/src/llama.cpp
# Hugging Face token: only needed for gated or private repos. Never commit it.
# HF_TOKEN=
